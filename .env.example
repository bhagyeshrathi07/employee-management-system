# =================================================================================================
# Employee Management System - environment template
#
# OPTIONAL. Every value below is already the built-in default, so the project runs with no .env
# file at all. Copy this file only if you want to change something:
#
#   cp .env.example .env
#
# Docker Compose reads .env automatically. For the manual setup, export the variables in your
# shell (e.g. `export SPRING_DATASOURCE_URL=...`) before running ./mvnw spring-boot:run.
# .env is git-ignored; never commit real secrets.
# =================================================================================================

# --- Docker Compose: host ports ----------------------------------------------------------------
FRONTEND_HOST_PORT=3000          # React UI            -> http://localhost:3000
BACKEND_HOST_PORT=8080           # Spring Boot API     -> http://localhost:8080
POSTGRES_HOST_PORT=5433          # PostgreSQL          -> localhost:5433 (5433 avoids clashing with a local PostgreSQL on 5432)

# --- Docker Compose: PostgreSQL container ------------------------------------------------------
POSTGRES_DB=employeedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Application login (HTTP Basic) - used by both Docker Compose and the manual setup -----------
APP_SECURITY_USERNAME=admin
APP_SECURITY_PASSWORD=admin123

# --- Seed 25 sample employees into an empty database (true/false) -------------------------------
APP_SEED_ENABLED=true

# --- Manual (non-Docker) backend only ----------------------------------------------------------
# Uncomment and adjust if your local PostgreSQL differs from the defaults.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/employeedb
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
# SERVER_PORT=8080
# LOG_LEVEL_SQL=WARN               # DEBUG to log SQL statements

# --- Frontend dev server only (Vite) ------------------------------------------------------------
# Leave unset to use the built-in /api proxy to http://localhost:8080.
# VITE_API_BASE_URL=http://localhost:8080/api/v1
